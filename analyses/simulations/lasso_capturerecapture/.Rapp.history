res2 = mean(res_BIC)#
res_AIC = (abs(lasso.occ[,6]) > 1e-3) & (abs(lasso.occ[,7]) < 1e-3)#
res3 = mean(res_AIC)#
restot=data.frame(AIC=res1,lassoBIC=res2,lassoAIC=res3)#
return(restot)#
}#
#
