BIC = 2*res_lassopath[[i]] + log(N)*num.v
BIC
penalty
which.min(BIC)
penalty[which.min(BIC)]
lasso.occ = res_lassopath[[i]][,which.min(BIC)]
lasso.occ
i
i=1
N = nh # to be checked#
num.v = apply(abs(res_lassopath[[i]]) > 1.e-3, 2, sum) - length(no.shrink)
num.v
res_lassolike
BIC = 2*res_lassolike[[i]] + log(N)*num.v
BIC
pen = penalty[which.min(BIC)] # get 'best' penalisation
pen
res_lassopath[[i]]
which.min(BIC)
res_lassopath[[i]][,which.min(BIC)]
lasso.occ = NULL#
for (i in 1:nboot){#
N = nh # to be checked#
num.v = apply(abs(res_lassopath[[i]]) > 1.e-3, 2, sum) - length(no.shrink)#
BIC = 2*res_lassolike[[i]] + log(N)*num.v#
